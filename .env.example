# ── Meta (Messenger + Instagram) — see docs/META-SETUP.md ────────────────────
# All three are read at runtime; none are required for local dev (without them
# the webhook simulator + mock delivery keep the CRM inbox fully working).

# Your own random string; paste the same value into the Meta webhook config
# ("Verify token"). Used by GET /api/crm/webhooks/[channel] for the
# hub.challenge handshake. Generate with: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=

# App settings → Basic → App Secret in developers.facebook.com. Verifies the
# X-Hub-Signature-256 header on every webhook POST. MANDATORY in production —
# without it the route refuses Meta payloads (503).
META_APP_SECRET=

# Page access token generated in Messenger API settings for the "Dental Med
# Travel Albania" Page (scopes: pages_messaging, instagram_manage_messages,
# pages_manage_metadata, pages_read_engagement, instagram_basic,
# instagram_manage_comments). One token serves Messenger AND Instagram DMs.
# Unset = outbound replies are mocked (stored in the inbox, never sent).
META_PAGE_ACCESS_TOKEN=

# ── WhatsApp Cloud API (optional, later) ─────────────────────────────────────
# System-user or temporary access token for the WhatsApp Business Cloud API.
WHATSAPP_ACCESS_TOKEN=

# The "Phone number ID" (NOT the phone number itself) from WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
